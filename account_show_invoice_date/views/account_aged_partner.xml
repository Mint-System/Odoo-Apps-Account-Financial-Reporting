<odoo>
    <template
        id="report_aged_receivable_document_custom"
        inherit_id="account_reports.report_aged_receivable_document"
    >
        <xpath expr="//table/tbody/tr" position="before">
            <!-- Add a new table header for invoice date -->
            <th>Invoice Date</th>
        </xpath>
        <xpath expr="//table/tbody/tr/td[@class='whitespace-nowrap']" position="before">
            <!-- Insert the invoice date for each line -->
            <td t-esc="line['invoice_date']" />
        </xpath>
    </template>

    <template
        id="report_aged_payable_document_custom"
        inherit_id="account_reports.report_aged_payable_document"
    >
        <xpath expr="//table/tbody/tr" position="before">
            <!-- Add a new table header for invoice date -->
            <th>Invoice Date</th>
        </xpath>
        <xpath expr="//table/tbody/tr/td[@class='whitespace-nowrap']" position="before">
            <!-- Insert the invoice date for each line -->
            <td t-esc="line['invoice_date']" />
        </xpath>
    </template>
</odoo>
